{
  "name": "staff/training-system",
  "description": "Staff Training and Development Tracking System",
  "type": "project",
  "require": {
    "php": ">=7.4",
    "phpmailer/phpmailer": "^6.6",
    "dompdf/dompdf": "^2.0",
    "tecnickcom/tcpdf": "^6.5",
    "monolog/monolog": "^3.0",
    "firebase/php-jwt": "^6.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5"
  },
  "autoload": {
    "psr-4": {
      "Staff\\Training\\": "src/"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "php -r \"copy('.env.example', '.env');\""
    ]
  }
}